# Kept — environment (TRD §7). Copy to .env.local and fill in. Never commit .env*.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Model providers
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_CHAIN_TRANSCRIBE=groq,openrouter
LLM_CHAIN_EXTRACT=openrouter,groq
# Optional model overrides (defaults in lib/llm/router.ts)
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
OPENROUTER_EXTRACT_MODEL=google/gemini-2.5-flash
OPENROUTER_TRANSCRIBE_MODEL=google/gemini-2.5-flash

# Trello (TRD-3.7)
TRELLO_API_KEY=

# 32-byte key, hex-encoded (64 hex chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# HMAC secret for share tokens. Generate: openssl rand -hex 32
SHARE_TOKEN_SECRET=

# Email (TRD-3.9)
RESEND_API_KEY=
EMAIL_FROM=Kept <kept@yourdomain.com>

# Secret for the scheduled reminder digest (Vercel Cron sends it as a Bearer token). Generate: openssl rand -hex 32
CRON_SECRET=

# Public URL of the deployed app, no trailing slash
APP_URL=http://localhost:3000
